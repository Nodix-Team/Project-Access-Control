# Logs (folder log runtime di root saja - JANGAN pakai pola tanpa slash di sini, itu bakal
# ikut nge-ignore src/pages/Logs/ juga karena git di Windows default case-insensitive)
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env - .env.example TETAP di-commit sebagai template, .env asli jangan (VITE_API_URL bisa beda
# per environment developer, dan ini kebiasaan standar walau isinya sekarang belum ada secret).
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
