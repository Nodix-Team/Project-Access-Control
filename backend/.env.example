# ==========================================
# Konfigurasi Backend - Access Control System
# ==========================================

# 1. Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# 2. Database Configuration (MySQL)
# Ganti 'root' dan 'password' sesuai dengan yang Anda buat di MySQL Workbench
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password_mysql_anda
DB_NAME=access_control

# 3. MQTT Broker Configuration (EMQX)
# Sesuaikan IP dan kredensial yang baru saja kita buat di EMQX
MQTT_BROKER=10.212.228.153
MQTT_PORT=1883
MQTT_USER=backend
MQTT_PASSWORD=backend123

# 4. Security
# Gunakan string acak panjang untuk JWT secret key di production!
JWT_SECRET_KEY=secret_key_sementara_untuk_dev_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 jam
