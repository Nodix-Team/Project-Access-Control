# ==========================================
# Konfigurasi Backend - Access Control API v0.2
# Salin file ini menjadi .env lalu isi dengan nilai asli (jangan commit .env!)
# ==========================================
# Nama variabel di bawah HARUS sama persis dengan yang dibaca app/config.py (class Settings).

# 1. Database Configuration (MySQL)
# Ganti 'access_control' dan password sesuai kredensial MySQL Anda.
DB_HOST=localhost
DB_PORT=3306
DB_USER=access_control
DB_PASSWORD=
DB_NAME=access_control

# 2. Security / JWT Auth
# Gunakan string acak panjang untuk JWT_SECRET_KEY di production!
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# 3. MQTT Broker Configuration (EMQX)
# Gunakan 127.0.0.1 jika menjalankan EMQX di mesin lokal, atau sesuaikan dengan IP mesin/VM lain.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=
