# Konfigurasi environment backend Access Control API v0.2
# Salin file ini menjadi .env lalu isi dengan nilai asli (jangan commit .env!)

# --- Database MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=access_control
DB_PASSWORD=
DB_NAME=access_control

# --- JWT Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- MQTT / EMQX Broker ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=
